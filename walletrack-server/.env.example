# ---- Server ----
NODE_ENV=development
PORT=4000

# ---- Database (MongoDB Atlas) ----
# Use a mongodb+srv://... URI for Atlas, or `memory` to run against a local
# mongod instead (data kept in .mongo-data/, needs mongodb-memory-server).
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?authSource=admin&retryWrites=true&w=majority
DB_NAME=walletrack

# ---- Sessions ----
# How long a sign-in stays valid. Accepts 30d, 12h, 90m, 3600 (seconds).
SESSION_EXPIRES=30d

# Comma separated list of allowed origins, or * to allow any
CLIENT_ORIGIN=*